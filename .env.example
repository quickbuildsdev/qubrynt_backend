# Copy this file to ".env" and edit the values.

# MongoDB connection string.
#  - Local MongoDB:   mongodb://127.0.0.1:27017/qubrynt
#  - MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qubrynt?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/qubrynt

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

PORT=5000

# Address of the frontend (used for CORS in development)
CLIENT_ORIGIN=http://localhost:5173

# Set to "production" when deploying
NODE_ENV=development
